    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7",
    "recharts": "^3.11.1",
    "sql.js": "^1.17.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.16.1",
    "@vitejs/plugin-react": "^6.1.2",
